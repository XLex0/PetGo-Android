<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- El tema real está en Compose (core/designsystem/Theme.kt). Esto es solo el contenedor de la Activity. -->
    <style name="Theme.PetGo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PetGo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/petgo_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.PetGo</item>
    </style>
</resources>
